# This is an example .env file. Copy this to .env and fill in the values.

# PostgreSQL connection settings
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# The DATABASE_URL is used by Prisma to connect to the PostgreSQL database. It should be in the format:
# postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public
#
# PRODUCTION (Supabase): Prisma 7 verifies the full TLS chain and Supabase uses a
# self-signed root CA. The Docker image bakes that CA into both trust stores (see
# Dockerfile), so you only need the session pooler URL (port 5432, NOT the 6543
# transaction pooler which breaks migrations) with sslmode=verify-full:
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full
#
# DATABASE_CA_CERT (optional): the runtime pg pool (prisma.service.ts) already
# trusts the CA via the baked-in stores above, so leave this UNSET in the Docker
# deploy. Set it only to scope trust to just the DB connection instead of the
# whole process; the value is the PEM CONTENTS of the CA (not a file path), which
# activates the explicit ssl.ca path in buildPoolConfig.
# DATABASE_CA_CERT=

# Set the NODE_ENV to "development" for local development. In production, this should be set to "production".
NODE_ENV=development
PORT=3000

# CORS allowlist: comma-separated origins allowed to call the API from a browser.
# Leave unset in dev to reflect any origin. REQUIRED in production: the app now
# sends CORS with credentials (for the httpOnly refresh cookie), and reflecting
# any origin with credentials is unsafe, so the boot FAILS if it is unset when
# NODE_ENV=production. Set it to the front-end origin(s),
# e.g. https://your-app.vercel.app,https://www.your-domain.com
# CORS_ORIGINS=

JWT_SECRET_KEY=

# Access token lifetime (short-lived JWT). Duration like "15m", "1h". Default 15m.
JWT_ACCESS_TTL=15m

# Refresh token lifetime (stateful, rotated). Duration like "7d", "12h". Default 7d.
JWT_REFRESH_TTL=7d

# Shared secret the payment gateway webhook must send in the "x-webhook-secret" header.
PAYMENT_WEBHOOK_SECRET=

# API key for the Gemini support assistant. Obtain from Google AI Studio. Required
# for POST /api/ai/chat - the Gemini adapter calls getOrThrow on boot.
GEMINI_API_KEY=

# Hard deadline (ms) for a single provider call, so a hung Gemini request cannot
# pin an HTTP connection. Optional; defaults to 30000. Must be a positive integer.
GEMINI_TIMEOUT_MS=

# Trust proxy: "true"/"false" or a number of trusted hops. Leave unset (off) in
# dev. Enable ONLY behind a trusted reverse proxy, otherwise X-Forwarded-For can
# be spoofed.
# TRUST_PROXY=

# Refresh-cookie "Secure" attribute: "true"/"false". Default true (cookie sent
# only over https). Set to "false" ONLY for local http dev.
# COOKIE_SECURE=true

# Refresh-cookie "SameSite" attribute: "strict"/"lax"/"none". Default "strict".
# Use "none" only for cross-site deploys (front and API on different domains,
# e.g. Vercel + Render); "none" REQUIRES COOKIE_SECURE=true (boot fails otherwise)
# and reopens CSRF (a CSRF-token mitigation is out of scope here).
# COOKIE_SAMESITE=strict

# Rate limit window in milliseconds. Default 60000.
THROTTLE_TTL_MS=60000

# Max requests per window per IP. Default 100.
THROTTLE_LIMIT=100

# Initial ADMIN bootstrap. Read at deploy time by scripts/bootstrap-admin.ts to
# create the first operator on a fresh instance. All four are REQUIRED only while
# the admin still has to be created; once it exists the bootstrap skips them and
# the password var can be removed. Never commit real values: set these in the
# host's secret store (e.g. Render env vars), not in a committed .env.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=