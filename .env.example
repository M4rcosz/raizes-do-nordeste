# This is an example .env file. Copy this to .env and fill in the values.

# PostgreSQL connection settings
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# The DATABASE_URL is used by Prisma to connect to the PostgreSQL database. It should be in the format:
# postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public

# Set the NODE_ENV to "development" for local development. In production, this should be set to "production".
NODE_ENV=development
PORT=3000

JWT_SECRET_KEY=

# Access token lifetime (short-lived JWT). Duration like "15m", "1h". Default 15m.
JWT_ACCESS_TTL=15m

# Refresh token lifetime (stateful, rotated). Duration like "7d", "12h". Default 7d.
JWT_REFRESH_TTL=7d

# Shared secret the payment gateway webhook must send in the "x-webhook-secret" header.
PAYMENT_WEBHOOK_SECRET=

# Trust proxy: "true"/"false" or a number of trusted hops. Leave unset (off) in
# dev. Enable ONLY behind a trusted reverse proxy, otherwise X-Forwarded-For can
# be spoofed.
# TRUST_PROXY=

# Rate limit window in milliseconds. Default 60000.
THROTTLE_TTL_MS=60000

# Max requests per window per IP. Default 100.
THROTTLE_LIMIT=100