// ============================================================
// DATABASE
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// IDENTITY & ACCESS
// ============================================================

enum Role {
  CUSTOMER
  ATTENDANT
  KITCHEN
  MANAGER
  ADMIN
}

model User {
  id             String  @id @default(uuid())
  businessUnitId String? @map("business_unit_id")

  name         String
  // citext: the @unique index compares case-insensitively, so "joao" and "Joao"
  // cannot coexist even if a seed or raw SQL bypasses the DTO regex.
  username     String   @unique @db.Citext
  // citext for the same reason as username: the @unique index compares
  // case-insensitively, so "Maria@x.com" and "maria@x.com" cannot become two
  // accounts even if a seed or raw SQL bypasses the DTO normalization.
  email        String?  @unique @db.Citext
  passwordHash String   @map("password_hash")
  phone        String?  @unique
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedById  String?  @map("updated_by")
  role         Role

  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  updatedBy    User?         @relation("UserUpdatedBy", fields: [updatedById], references: [id])

  businessUnits UserBusinessUnit[]

  customerOrders        Order[]                @relation("CustomerOrders")
  attendantOrders       Order[]                @relation("AttendantOrders")
  inventoryTransactions InventoryTransaction[]
  loyaltyAccounts       LoyaltyAccount[]
  aiMemberships         AiMembership[]
  refreshTokens         RefreshToken[]

  userUpdatedBy            User[]           @relation("UserUpdatedBy")
  ordersUpdatedBy          Order[]          @relation("OrdersUpdatedBy")
  loyaltyAccountsUpdatedBy LoyaltyAccount[] @relation("LoyaltyAccountsUpdatedBy")
  aiMembershipsUpdatedBy   AiMembership[]   @relation("AiMembershipsUpdatedBy")

  @@index([role])
  @@index([businessUnitId])
  @@index([createdAt, id])
  @@map("users")
}

// Join table: a staff member may be scoped to several business units (N:N).
// Replaces the single User.businessUnitId scope. The legacy column is kept for the
// expand phase and dropped in a later contract migration (see release notes).
model UserBusinessUnit {
  userId         String   @map("user_id")
  businessUnitId String   @map("business_unit_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([userId, businessUnitId])
  @@index([businessUnitId])
  @@map("user_business_units")
}

// Stateful refresh token (rotation strategy). We persist only the SHA-256 hash
// of an opaque high-entropy value; the plaintext lives client-side only. Each
// rotation revokes the old row and links it to its successor via replacedById,
// so a re-presented revoked token (reuse) lets us walk and kill the chain.
model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================
// BUSINESS UNITS & MENU
// ============================================================

model BusinessUnit {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  address   String
  city      String
  phone     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  userLinks  UserBusinessUnit[]
  orders     Order[]
  menuItems  BusinessUnitMenuItem[]
  inventory  Inventory[]
  promotions Promotion[]

  @@map("business_units")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         String @id @default(uuid())
  categoryId String @map("category_id")

  name        String   @unique
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  imageUrl    String   @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category   Category               @relation(fields: [categoryId], references: [id])
  menuItems  BusinessUnitMenuItem[]
  inventory  Inventory[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model BusinessUnitMenuItem {
  id             String @id @default(uuid())
  businessUnitId String @map("business_unit_id")
  productId      String @map("product_id")

  customPrice Decimal  @map("custom_price") @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([businessUnitId, productId])
  @@map("business_unit_menu_items")
}

// ============================================================
// INVENTORY
// ============================================================

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
}

model Inventory {
  id             String @id @default(uuid())
  businessUnitId String @map("business_unit_id")
  productId      String @map("product_id")

  quantity    Int
  minQuantity Int      @map("min_quantity")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  inventoryTransactions InventoryTransaction[]

  @@unique([businessUnitId, productId])
  // Supports the cursor page: filter by unit, order by (createdAt, id). Without it
  // Postgres can't use the unique above for the sort and falls back to an in-memory sort.
  @@index([businessUnitId, createdAt, id])
  @@map("inventories")
}

model InventoryTransaction {
  id          String  @id @default(uuid())
  inventoryId String  @map("inventory_id")
  orderId     String? @map("order_id")
  createdBy   String  @map("created_by")

  type      InventoryTransactionType
  quantity  Int
  reason    String
  createdAt DateTime                 @default(now()) @map("created_at")

  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  order         Order?    @relation(fields: [orderId], references: [id])
  createdByUser User      @relation(fields: [createdBy], references: [id])

  @@index([inventoryId])
  @@index([orderId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ============================================================
// ORDERS
// ============================================================

enum OrderChannel {
  APP
  WEB
  TOTEM
  COUNTER
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id             String  @id @default(uuid())
  businessUnitId String  @map("business_unit_id")
  customerId     String? @map("customer_id")
  // Guest name for orders with no account behind them (TOTEM/COUNTER/PICKUP walk-ups).
  // Mutually exclusive with customerId: when an account is attached the display name
  // resolves from the User relation, so this column stays NULL (no stale copy).
  customerName   String? @map("customer_name") @db.VarChar(60)
  attendantId    String? @map("attendant_id")

  pointsRedeemed Int          @default(0) @map("points_redeemed")
  pointsEarned   Int          @default(0) @map("points_earned")
  totalAmount    Decimal      @map("total_amount") @db.Decimal(10, 2)
  notes          String?
  orderChannel   OrderChannel @map("order_channel")
  orderStatus    OrderStatus  @default(PENDING) @map("order_status")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedById    String?      @map("updated_by")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])
  customer     User?        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  attendant    User?        @relation("AttendantOrders", fields: [attendantId], references: [id])
  updatedBy    User?        @relation("OrdersUpdatedBy", fields: [updatedById], references: [id])

  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  payments              Payment[]
  orderPromotions       OrderPromotion[]
  loyaltyTransactions   LoyaltyTransaction[]

  @@index([customerId])
  @@index([businessUnitId])
  @@index([orderStatus])
  @@index([orderChannel])
  @@index([createdAt, id])
  // Serves "orders served by X, newest first" as an ordered scan instead of a
  // bitmap scan plus sort. attendantId leads, so it still backs the FK check.
  @@index([attendantId, createdAt, id])
  // Mirrors the (sort column, id) shape of createdAt so sorting by total keeps a
  // stable tie-break and the row cursor stays index-backed. Deliberately not led by
  // businessUnitId: an unfiltered ADMIN has no unit predicate to lead with.
  @@index([totalAmount, id])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  notes     String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================
// PAYMENTS
// ============================================================

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  CASH
  VOUCHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  REFUSED
  CANCELLED
  REFUNDED
}

model Payment {
  id      String @id @default(uuid())
  orderId String @map("order_id")

  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  extTransactionId String?       @unique @map("ext_transaction_id")
  gatewayRequest   Json?         @map("gateway_request")
  gatewayResponse  Json?         @map("gateway_response")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  // A payment is one *attempt*: an order may have many, at most one live/settled.
  // The "one live attempt per order" rule is a partial unique index added in the
  // migration SQL (Prisma can't express a filtered index in the schema).
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ============================================================
// PROMOTIONS
// ============================================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_ITEM
}

model Promotion {
  id             String @id @default(uuid())
  businessUnitId String @map("business_unit_id")

  name          String
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderValue Decimal      @map("min_order_value") @db.Decimal(10, 2)
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])

  orderPromotions OrderPromotion[]

  @@index([businessUnitId])
  @@index([isActive, startDate, endDate])
  @@map("promotions")
}

model OrderPromotion {
  id          String @id @default(uuid())
  orderId     String @map("order_id")
  promotionId String @map("promotion_id")

  discountApplied Decimal @map("discount_applied") @db.Decimal(10, 2)

  order     Order     @relation(fields: [orderId], references: [id])
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@map("order_promotions")
}

// ============================================================
// LOYALTY
// ============================================================

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

model LoyaltyAccount {
  id         String @id @default(uuid())
  customerId String @unique @map("customer_id")

  totalPoints      Int       @default(0) @map("total_points")
  consentGiven     Boolean   @default(false) @map("consent_given")
  consentDate      DateTime? @map("consent_date")
  consentRevokedAt DateTime? @map("consent_revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedById      String?   @map("updated_by")

  customer  User  @relation(fields: [customerId], references: [id])
  updatedBy User? @relation("LoyaltyAccountsUpdatedBy", fields: [updatedById], references: [id])

  loyaltyTransactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

// Per-user AI token quota. tokenBalance depletes as tokens are spent (Part 2) and
// is topped up by an admin (enroll + adjust). Tokens are a plain Int count, not
// money, so no Decimal here. Balance changes are conditional so it never goes negative.
model AiMembership {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  tokenBalance Int      @default(0) @map("token_balance")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedById  String?  @map("updated_by")

  user      User  @relation(fields: [userId], references: [id])
  updatedBy User? @relation("AiMembershipsUpdatedBy", fields: [updatedById], references: [id])

  @@map("ai_memberships")
}

model LoyaltyTransaction {
  id               String  @id @default(uuid())
  loyaltyAccountId String  @map("loyalty_account_id")
  orderId          String? @map("order_id")

  type        LoyaltyTransactionType
  points      Int
  description String
  createdAt   DateTime               @default(now()) @map("created_at")
  // Only set on EARN: when this lot expires (createdAt + 12 months). The sweep nets
  // out lots past this date FIFO. Null on REDEEM/EXPIRE/ADJUSTMENT (they never expire).
  expiresAt   DateTime?              @map("expires_at")

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])

  // One transaction of each type per order: makes EARN idempotent at the DB level
  // (a duplicate credit fails closed instead of silently double-crediting). orderId
  // is nullable and Postgres treats NULLs as distinct, so manual movements with no
  // order (ADJUSTMENT/EXPIRE) are not constrained.
  @@unique([orderId, type])
  @@index([loyaltyAccountId])
  @@index([orderId])
  @@index([expiresAt])
  @@map("loyalty_transactions")
}

// ============================================================
// IDEMPOTENCY
// ============================================================

// One row per (user, endpoint, key). Presence means the operation completed:
// the row is inserted in the SAME transaction as the order, so it can never
// exist without its order. orderId links the stored result for replay. A retry
// with the same key returns that order; the same key with a different body is a
// reuse error. Rows are reaped after expiresAt (TTL); orderId carries no FK so
// the table stays decoupled from the orders schema.
model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String
  userId      String   @map("user_id")
  endpoint    String
  requestHash String   @map("request_hash")
  orderId     String?  @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
